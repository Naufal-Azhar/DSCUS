# Database
DATABASE_URL=postgresql://decisionmirror:password@localhost:5432/decisionmirror

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Security
SECRET_KEY=generate-a-secure-random-key-here
SESSION_EXPIRY_HOURS=24

# LLM Provider
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4
LLM_TIMEOUT=45
LLM_MAX_TOKENS=4000

# Feature Flags
ENABLE_FIXTURE_MODE=true
ENABLE_LLM=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
